# Copy this file to tests/.env and fill in real values.
# tests/.env is git-ignored — real credentials never end up in the repo.

# The URL Playwright hits. Defaults to production; point at a preview
# deploy URL when you want to test a branch before merging.
BASE_URL=https://phc-team.com

# Admin test account (used for admin-facing tests: schedule, analytics, patient chart)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Non-admin provider test account (used for provider Today view, note signing)
TEST_PROVIDER_EMAIL=
TEST_PROVIDER_PASSWORD=

# Family test account (used for family self-book, cancel, view visits)
TEST_FAMILY_EMAIL=
TEST_FAMILY_PASSWORD=

# ID of a child on the test family account (used to target booking flows)
TEST_CHILD_ID=
